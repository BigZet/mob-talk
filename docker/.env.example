# Copy to docker/.env on the server and fill in. docker/.env is in .gitignore: never commit it, never paste it in chat.
# Keys for the mods (only the server has them; players never see them).
OPENROUTER_API_KEY=
VENICE_API_KEY=
ELEVENLABS_API_KEY=
# The web admin password is generated on the first start and shown once in the log
# (docker compose logs mc | grep -i админка); change it with /mobtalk admin web password <new>.
# Allowlist and operators: nicknames separated by commas.
WHITELIST=
OPS=
TZ=Europe/Moscow
