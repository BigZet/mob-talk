# Copy to docker/.env on the server and fill in. docker/.env is in .gitignore: never commit it, never paste it in chat.
# Keys for the mods (only the server has them; players never see them).
OPENROUTER_API_KEY=
VENICE_API_KEY=
ELEVENLABS_API_KEY=
# The web admin password is generated on the first start and shown once in the log
# (docker compose logs mc | grep -i админка); change it with /mobtalk admin web password <new>.
# Allowlist and operators: nicknames separated by commas.
WHITELIST=
OPS=
TZ=Europe/Moscow
# OpenRouter refuses Russian IPs: route the providers through a local HTTP proxy (sing-box/Clash on the host, network_mode or
# the host's address as seen from the container), the game's own traffic stays direct. Leave empty without a proxy.
# JVM_OPTS=-Dhttps.proxyHost=host.docker.internal -Dhttps.proxyPort=8118 -Dhttp.proxyHost=host.docker.internal -Dhttp.proxyPort=8118 -Dhttp.nonProxyHosts=localhost|127.*
