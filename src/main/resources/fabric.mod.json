{
  "schemaVersion": 1,
  "id": "mobtalk",
  "version": "${version}",
  "name": "Mob Talk",
  "description": "Наведите прицел на моба и поговорите с ним голосом: локальный Whisper, OpenRouter и ElevenLabs.",
  "authors": ["BigZet"],
  "license": "GPL-3.0-only",
  "environment": "*",
  "entrypoints": {
    "main": ["io.github.mobtalk.MobTalkMod"],
    "client": ["io.github.mobtalk.client.MobTalkClient"],
    "mobtalk-stt": ["io.github.mobtalk.server.MobTalkStt"],
    "mobtalk-stt-player": ["io.github.mobtalk.server.MobTalkPlayerStt"],
    "mobtalk-admin": ["io.github.mobtalk.server.web.MobTalkAdminSource"],
    "mobtalk-events": ["io.github.mobtalk.server.DivineEvents"]
  },
  "mixins": [
    "mobtalk.mixins.json",
    { "config": "mobtalk.client.mixins.json", "environment": "client" }
  ],
  "depends": { "fabricloader": ">=0.19.5", "minecraft": "1.21.1", "java": ">=21", "fabric-api": "*" }
}
