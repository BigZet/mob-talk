{
  "multipart": [
    {
      "when": {
        "cy": "0"
      },
      "apply": {
        "model": "parrotcages:block/small_parrot_cage_floor"
      }
    },
    {
      "when": {
        "cy": "1"
      },
      "apply": {
        "model": "parrotcages:block/cage_roof"
      }
    },
    {
      "when": {
        "cz": "0"
      },
      "apply": {
        "model": "parrotcages:block/cage_wall"
      }
    },
    {
      "when": {
        "cx": "0"
      },
      "apply": {
        "model": "parrotcages:block/cage_wall",
        "y": 90
      }
    },
    {
      "when": {
        "cz": "0"
      },
      "apply": {
        "model": "parrotcages:block/cage_wall",
        "y": 180
      }
    },
    {
      "when": {
        "cx": "0"
      },
      "apply": {
        "model": "parrotcages:block/cage_wall",
        "y": 270
      }
    }
  ]
}
